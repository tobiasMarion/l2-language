# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "Parser, type inference and big-step evaluator for L2, a functional language with imperative constructs"
description:
  "An implementation of L2: arithmetic and boolean expressions, typed let bindings, conditionals, and imperative constructs (references with new, dereference and assignment, sequencing and while loops). The project contains a parser, a type inference algorithm and a big-step operational semantics evaluator. Final project for Programming Languages I (INF05029) at the Institute of Informatics, Federal University of Rio Grande do Sul (UFRGS), 2026/2."
maintainer: ["Tobias Cadoná Marion"]
authors: ["Tobias Cadoná Marion" "João Kenji Suwa" "Gabriel Richter"]
license: "MIT"
tags: [
  "programming languages"
  "interpreter"
  "type inference"
  "type system"
  "operational semantics"
  "big-step semantics"
  "parser"
  "references"
]
homepage: "https://github.com/tobiasMarion/l2-language"
bug-reports: "https://github.com/tobiasMarion/l2-language/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.25"}
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "utop" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tobiasMarion/l2-language.git"
x-maintenance-intent: ["(latest)"]
